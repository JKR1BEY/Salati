{
  "name": "salati",
  "version": "1.1.10",
  "description": "صلاتي — مواقيت الصلاة بتصميم بسيط وأنيق",
  "main": "main.js",
  "author": "Salati",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "release": "electron-builder --win nsis --publish always",
    "ship": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\ship.ps1"
  },
  "dependencies": {
    "adhan": "^4.4.6",
    "electron-updater": "^6.8.11",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "app.salati.prayer",
    "productName": "Salati",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "JKR1BEY",
      "repo": "Salati",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "scripts/taskbar-watch.ps1",
      "scripts/create-shortcut.ps1",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/taskbar-watch.ps1",
      "scripts/create-shortcut.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Salati-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Salati",
      "include": "installer.nsh"
    }
  }
}
